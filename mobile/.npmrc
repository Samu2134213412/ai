# expo-router@57 pulls in web-only dev tooling (@radix-ui/* via react-dom) whose
# peer dependency on react (^19.3.0) is stricter than the exact react version
# Expo's SDK 57 manifest bundles and tests against (19.2.3, which itself
# satisfies react-native's own ^19.2.3 requirement). We build Android only, so
# that web-tooling peer is never actually exercised. legacy-peer-deps keeps npm
# from hard-failing on it without us having to hand-pick a newer, untested React.
legacy-peer-deps=true
