# Vorlage für /config/secrets.yaml auf dem Pi.
# Kopieren, Werte eintragen – die echte Datei kommt NIE ins Repo.
# In anderen YAML-Dateien referenzierst du Werte mit:  !secret name

# --- ab M3: Gehirn ---------------------------------------------------------
# gaming_pc_mac: "AA:BB:CC:DD:EE:FF"
# gaming_pc_host: "192.168.178.50"

# --- ab M6: Drucker --------------------------------------------------------
# x2d_host: "192.168.178.60"
# x2d_serial: "..."
# x2d_access_code: "..."
