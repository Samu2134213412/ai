{
  "name": "tutor-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tutor \u2013 Desktop-App f\u00fcr Windows, macOS und Linux",
  "author": "Tutor",
  "main": "main.js",
  "scripts": {
    "build-www": "node ../scripts/vendor-wllama.mjs && node ../scripts/build-www.mjs www && node ../scripts/copy-server.mjs",
    "start": "npm run build-www && electron .",
    "dist": "npm run build-www && electron-builder --publish never",
    "test": "node --test test/lib.test.js",
    "dist:exe": "npm run build-www && electron-builder --win portable --publish never",
    "dist:mac": "npm run build-www && electron-builder --mac dmg --publish never",
    "dist:linux": "npm run build-www && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.tutor.desktop",
    "productName": "Tutor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "server/**",
      "www/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tutor-Setup.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "Tutor.exe"
    },
    "dmg": {
      "artifactName": "Tutor.dmg"
    },
    "appImage": {
      "artifactName": "Tutor.AppImage"
    },
    "deb": {
      "artifactName": "tutor-desktop.deb"
    },
    "publish": null
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "@wllama/wllama": "3.8.1",
    "@wllama/wllama-compat": "3.8.1"
  }
}
